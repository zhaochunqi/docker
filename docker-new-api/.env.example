# Litestream S3 credentials
LITESTREAM_ACCESS_KEY_ID=your_access_key_id
LITESTREAM_SECRET_ACCESS_KEY=your_secret_access_key

# Cloudflare R2 (S3-compatible) settings
CLOUDFLARE_R2_BUCKET_NAME=your-bucket
CLOUDFLARE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
CLOUDFLARE_R2_PATH=new-api

# Database path (optional, default: /data/one-api.db)
SQLITE_DB_PATH=/data/one-api.db
