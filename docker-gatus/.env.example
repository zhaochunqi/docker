# Litestream S3 备份配置（必填）
LITESTREAM_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
LITESTREAM_S3_BUCKET=your-bucket-name
LITESTREAM_S3_PATH=gatus
LITESTREAM_ACCESS_KEY_ID=your-access-key-id
LITESTREAM_SECRET_ACCESS_KEY=your-secret-access-key

# 可选：无可用备份时阻断启动（1=阻断；0/未设=放行空库+告警）
# STRICT_RESTORE=1